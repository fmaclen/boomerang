# Rendered by the nginx image's envsubst entrypoint into
# /etc/nginx/conf.d/default.conf. ${HISTORY} is the only placeholder; nginx's
# own $variables are left alone because envsubst only touches names set in the
# environment.

server {
    listen 3000;
    root /usr/share/nginx/html;

    # One box, one visitor at a time: logging would only cost disk and I/O
    # during a transfer.
    access_log off;
    sendfile on;
    tcp_nopush on;

    # The download test: 100 MB of random bytes written at image build time.
    # Must not be compressed or cached, or the rate measured is not the link's.
    location = /downloading {
        gzip off;
        add_header Cache-Control no-store;
    }

    # The upload test. nginx answers before reading the body and then drains
    # it, so a chunk must finish arriving within lingering_time. Each stream
    # posts 8 MB chunks, so 64m is eight chunks of headroom. An 8 MB chunk takes
    # 64 s at 1 Mbps, past the 30 s default lingering_time, so the drain gets
    # 120 s overall and 30 s between reads before a slow uplink is cut off.
    location = /upload {
        client_max_body_size 64m;
        client_body_timeout 120s;
        lingering_time 120s;
        lingering_timeout 30s;
        add_header Cache-Control no-store;
        return 200;
    }

    location = /ping {
        add_header Cache-Control no-store;
        return 204;
    }

    # The box's runs, kept by the store on loopback (server/store.ts). A
    # browser-only box runs no store, so it answers as if there were none.
    # A run carries its samples, so the list is worth compressing.
    location = /runs {
        set $history ${HISTORY};
        if ($history = browser) {
            return 404;
        }
        client_max_body_size 256k;
        gzip on;
        gzip_types application/json;
        gzip_proxied any;
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
    }

    # SvelteKit hashes the names of everything under immutable/, so it can be
    # cached for good.
    location /_app/immutable/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # The page. index.html is the app's one shell, served for / and for every
    # address that is not a file, /history included. The meta tag ships as
    # "box"; this writes in the HISTORY the container was started with.
    location / {
        sub_filter 'content="box"' 'content="${HISTORY}"';
        sub_filter_once on;
        try_files $uri /index.html;
    }
}

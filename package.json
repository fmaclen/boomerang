{
  "name": "boomerang",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "bun --bun vite build",
    "start": "BODY_SIZE_LIMIT=64M bun build/index.js",
    "build:site": "bun --bun vite build --mode demo",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "playwright test",
    "shots": "SHOTS=1 playwright test --project=shots"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@semantic-release/git": "^11.0.1",
    "@sveltejs/adapter-node": "^6.0.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "semantic-release": "^25.0.9",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.0",
    "vite": "^8.3.5"
  }
}
